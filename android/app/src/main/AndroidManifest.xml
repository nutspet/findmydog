<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 旧写法在这里声明 package="cn.nutspet.finddog"，AGP 8+ 已废弃，
         改由 app/build.gradle 的 namespace 声明。 -->

    <!-- The INTERNET permission is required for development. Specifically,
         flutter needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- 手工加入的地理位置权限 比官方例子要多 -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!--<uses-permission android:name="android.hardware.location.gps" />-->
    <uses-permission android:name="android.hardware.location.network" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- v2 embedding 下 android:name 使用 Flutter Gradle Plugin 注入的
         ${applicationName} 占位符（默认为 android.app.Application）。
         旧写法 io.flutter.app.FlutterApplication 已在 Flutter 3.x 移除。 -->
    <application
        android:name="${applicationName}"
        android:label="寻狗"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- 启动画面结束后切到此主题（v2 embedding 专用），替代旧的
                 io.flutter.app.android.SplashScreenUntilFirstFrame -->
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />
            <!--腾讯乐固要用的-->
            <meta-data android:name="channel" android:value="test" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>

    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.
         （targetSdk 30+ 的包可见性要求，Flutter 引擎的 ProcessTextPlugin 会用到） -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
